# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- PostgreSQL -------------------------------------------------------
# Superuser / owner connection. Used ONLY by `npm run db:setup` to create
# the database, schema and roles. The web app never uses it.
PG_ADMIN_URL=postgresql://<your-postgres-user>@localhost:5432/postgres

# Name of the database to create
PG_DATABASE=fcis

# Connection the web app uses. fcis_app is a NOINHERIT login role that
# must SET ROLE to fcis_viewer / fcis_analyst / fcis_admin per request.
# `npm run db:setup` sets this role's password to the one written here.
DATABASE_URL=postgresql://fcis_app:<choose-a-password>@localhost:5432/fcis

# --- MongoDB ----------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=fcis

# --- Sessions ---------------------------------------------------------
# 32+ random characters, e.g. `openssl rand -hex 32`
AUTH_SECRET=<random-secret>
